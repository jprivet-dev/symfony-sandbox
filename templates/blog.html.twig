{% extends 'base.html.twig' %}

{% block title %}Blog{% endblock %}

{% block body %}
    <div>
        <div class="pb-6 pt-6">
            <h1 class="text-3xl font-extrabold leading-9 tracking-tight text-gray-900 dark:text-gray-100 sm:hidden sm:text-4xl sm:leading-10 md:text-6xl md:leading-14">
                All Posts
            </h1>
        </div>
        <div class="flex sm:space-x-24">
            <div class="hidden h-full max-h-screen min-w-[280px] max-w-[280px] flex-wrap overflow-auto rounded bg-gray-50 pt-5 shadow-md dark:bg-gray-900/70 dark:shadow-gray-800/40 sm:flex">
                <div class="px-6 py-4">
                    <ul>
                        {% set classesActive = "px-3 py-2 text-sm font-medium uppercase text-primary-500 hover:text-primary-600 dark:hover:text-primary-400" %}
                        {% set classesDefault = "px-3 py-2 text-sm font-medium uppercase text-gray-500 hover:text-primary-500 dark:text-gray-300 dark:hover:text-primary-500" %}
                        <li class="my-3">
                            {% if currentTag.id is not defined %}
                                {% set classes = classesActive %}
                            {% else %}
                                {% set classes = classesDefault %}
                            {% endif %}
                            <twig:MenuLinkElement
                                    classes_active="{{ classesActive }}"
                                    classes_default="{{ classesDefault }}"
                                    class="{{ classes }}"
                                    href="{{ path('app_blog') }}"
                                    label="All posts ({{ postsCount }})"
                                    aria-label="View all posts"
                            ></twig:MenuLinkElement>
                        </li>
                        {% for tag in tags %}
                            <li class="my-3">
                                {% if currentTag.id is defined and currentTag.id == tag.id %}
                                    {% set classes = classesActive %}
                                {% else %}
                                    {% set classes = classesDefault %}
                                {% endif %}
                                <twig:MenuLinkElement
                                        classes_active="{{ classesActive }}"
                                        classes_default="{{ classesDefault }}"
                                        class="{{ classes }}"
                                        href="{{ path('app_blog_posts_by_tag_id', { 'id': tag.id }) }}"
                                        label="{{ tag.name }} ({{ tag.postsCount }})"
                                        aria-label="View posts tagged {{ tag.name }}"
                                ></twig:MenuLinkElement>
                            </li>
                        {% endfor %}
                    </ul>
                </div>
            </div>
            <div id="posts-by-tag">
                <ul>
                    {% for post in posts %}
                        <li class="py-5">
                            <article class="flex flex-col space-y-2 xl:space-y-0">
                                <dl>
                                    <dt class="sr-only">
                                        Published on
                                    </dt>
                                    <dd class="text-base font-medium leading-6 text-gray-500 dark:text-gray-400">
                                        <time dateTime="2023-08-05T00:00:00.000Z">
                                            {{ post.publishedAt|format_datetime('long', 'medium', '', 'UTC') }}
                                        </time>
                                    </dd>
                                </dl>
                                <div class="space-y-3">
                                    <div>
                                        <h2 class="text-2xl font-bold leading-8 tracking-tight">
                                            <a class="text-gray-900 dark:text-gray-100" href="{{ path('app_blog_post', {slug: post.slug}) }}">
                                                {{ post.title }}
                                            </a>
                                        </h2>
                                        <div class="flex flex-wrap">
                                            {% for tag in post.tags %}
                                                <a class="mr-3 text-sm font-medium uppercase text-primary-500 hover:text-primary-600 dark:hover:text-primary-400" href="{{ path('app_blog_posts_by_tag_id', { 'id': tag.id }) }}">
                                                    {{ tag.name }}
                                                </a>
                                            {% endfor %}
                                        </div>
                                    </div>
                                    <div class="prose max-w-none text-gray-500 dark:text-gray-400">
                                        {{ post.summary }}
                                    </div>
                                </div>
                            </article>
                        </li>
                    {% endfor %}
                </ul>

                {{ knp_pagination_render(posts) }}
            </div>
        </div>
    </div>
{% endblock %}
