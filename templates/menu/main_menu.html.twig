{# See vendor/knplabs/knp-menu/src/Knp/Menu/Resources/views/knp_menu.html.twig #}

{% extends 'knp_menu_base.html.twig' %}

{% macro attributes(attributes) %}
    {% for name, value in attributes %}
        {%- if value is not none and value is not same as(false) -%}
            {{- ' %s="%s"'|format(name, value is same as(true) ? name|e : value|e)|raw -}}
        {%- endif -%}
    {%- endfor -%}
{% endmacro %}

{% block compressed_root %}
    {% apply knp_menu_spaceless %}
        <div class="no-scrollbar hidden max-w-40 items-center space-x-4 overflow-x-auto sm:flex sm:space-x-6 md:max-w-72 lg:max-w-96">
            {{ block('root') }}
        </div>
    {% endapply %}
{% endblock %}

{% block root %}
    {% set listAttributes = item.childrenAttributes %}
    {{ block('list') -}}
{% endblock %}

{% block list %}
    {% if item.hasChildren and options.depth is not same as(0) and item.displayChildren %}
        {% import _self as knp_menu %}
        {{ block('children') }}
    {% endif %}
{% endblock %}

{% block children %}
    {% set currentItem = item %}
    {% for item in currentItem.children %}
        {{ block('item') }}
    {% endfor %}
{% endblock %}

{% block item %}
    {% if item.displayed %}
        {# displaying the item #}
        {% import _self as knp_menu %}
        {%- if item.uri is not empty %}
            {{ block('linkElement') -}}
        {%- endif %}
    {% endif %}
{% endblock %}

{% block linkElement %}{% import _self as knp_menu %}
    {%- set classesActive = 'block font-medium text-primary-500 hover:text-primary-600 dark:hover:text-primary-400' %}
    {%- set classesDefault = 'block font-medium text-gray-900 hover:text-primary-500 dark:text-gray-100 dark:hover:text-primary-400' %}
    {%- set attributes = item.linkAttributes %}
    {%- set classes = attributes.class is defined ? [attributes.class] : [] %}
    {%- if matcher.isCurrent(item) %}
        {%- set classes = classes|merge([classesActive]) %}
    {%- else %}
        {%- set classes = classes|merge([classesDefault]) %}
    {%- endif %}
    {%- set attributes = attributes|merge({class: classes|join(' ')}) %}
    {# <a href="{{ item.uri }}"{{ knp_menu.attributes(attributes) }}>{{ block('label') }}</a> #}
    <twig:MenuLinkElement
            classes_active="{{ classesActive }}"
            classes_default="{{ classesDefault }}"
            attributes="{{ attributes }}"
            href="{{ item.uri }}"
            label="{{ block('label') }}"
    ></twig:MenuLinkElement>
{% endblock %}

{% block label %}{% if options.allow_safe_labels and item.getExtra('safe_label', false) %}{{ item.label|raw }}{% else %}{{ item.label }}{% endif %}{% endblock %}
